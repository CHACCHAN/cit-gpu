#!/bin/bash

#SBATCH --partition=research
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus-per-task=4
#SBATCH --mem=480G
#SBATCH --time=24:00:00
##SBATCH --container=pytorch/pytorch:2.11.0-cuda13.0-cudnn9-devel
#SBATCH --output=logs/%j.log
#SBATCH --error=logs/%j.err

##CONTAINER --shm-size=64G

# 新習志野 (gpumng, RTX A4500 20GB x4) / Qwen3.8-27B-AWQ-INT4 / TP=4
# 共通パイプラインは src/launch.py。ここにはサイト固有の差分だけを書く。

set -euo pipefail
# コンテナ起動 (--container 有効時) はスクリプトが /tmp/slurm/startup へ
# コピーされ SLURM_SUBMIT_DIR も渡らないので dirname "$0" は使えない。
# 素のノードでも cwd は submit dir で始まるので $PWD に落とす (津田沼と同じ)。
cd "${SLURM_SUBMIT_DIR:-$PWD}"

set -a
source "${ENV_FILE:-.env}"
set +a

# 素のノード (コンテナ不使用) なので pip wheel の CUDA toolchain 補正が要る
export SG_CUDA_FIXUPS="${SG_CUDA_FIXUPS:-1}"

# このノード群は GPU 間 P2P (CUDA IPC) が壊れた個体を含む。壊れた GPU へ
# P2P で書くとエラーも出さずゼロが返り、NCCL の all_reduce が永久に返らない
# (src/p2p_check.py で確認できる。詳細は README「分散初期化のハング」)。
# P2P を切って NCCL を共有メモリ経由に落とす。サイト側で直ったら .env で 0 に。
SG_NCCL_P2P_DISABLE="${SG_NCCL_P2P_DISABLE:-1}"
if [[ "$SG_NCCL_P2P_DISABLE" == "1" ]]; then
    export NCCL_P2P_DISABLE=1
fi

# serve へのサイト固有引数。共通分は src/serve.py の base_args()。
# 渡していないもの:
#   --quantization      config.json から compressed-tensors が自動で読まれる
#   --moe-runner-backend Qwen3.8-27B は dense (MoE は無い)
#   --kv-cache-dtype    checkpoint が宣言しないので auto=bf16
#   --page-size         hybrid GDN の既定 1 のまま
#   speculative / MTP   最初は使わない
ARGS=(
    --dist-timeout "${SG_DIST_TIMEOUT:-600}"
    --max-queued-requests "${SG_MAX_QUEUED_REQUESTS:?}"
    --mamba-ssm-dtype "${SG_MAMBA_SSM_DTYPE:?}"
    --mamba-radix-cache-strategy "${SG_MAMBA_RADIX_CACHE_STRATEGY:?}"
    --mamba-full-memory-ratio "${SG_MAMBA_FULL_MEMORY_RATIO:?}"
    --enable-metrics
)

# custom all-reduce は NCCL を通さず自前で CUDA IPC を張るので、
# NCCL_P2P_DISABLE では避けられない。P2P を切るときは一緒に無効化する
if [[ "$SG_NCCL_P2P_DISABLE" == "1" ]]; then
    ARGS+=(--disable-custom-all-reduce)
fi
if [[ -n "${SG_DIST_INIT_ADDR:-}" ]]; then
    ARGS+=(--dist-init-addr "$SG_DIST_INIT_ADDR")
fi
if [[ -n "${SG_ATTENTION_BACKEND:-}" ]]; then
    ARGS+=(--attention-backend "$SG_ATTENTION_BACKEND")
fi
if [[ -n "${SG_SAMPLING_BACKEND:-}" ]]; then
    ARGS+=(--sampling-backend "$SG_SAMPLING_BACKEND")
fi
if [[ "${SG_ENABLE_HICACHE:-0}" == "1" ]]; then
    ARGS+=(
        --enable-hierarchical-cache
        --hicache-size "${SG_HICACHE_SIZE:-40}"
        --hicache-write-policy "${SG_HICACHE_WRITE_POLICY:-write_through}"
    )
fi

exec python3 -u src/launch.py --marker chat_template.jinja -- "${ARGS[@]}"
