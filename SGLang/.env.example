# SGLang
SG_MODEL_REPO=deepseek-ai/DeepSeek-V4-Flash-0731
SG_MODEL=models/DeepSeek-V4-Flash-0731

SG_SERVED_MODEL_NAME=deepseek-v4-flash
SG_HOST=0.0.0.0
SG_PORT=5050

SG_TP_SIZE=2

# routed expert が MXFP4 なので Hopper では W4A16 が必須。
# marlin 指定時のみ sglang が Mxfp4MarlinMoEMethod を選ぶ (auto では誤読する)
SG_MOE_RUNNER_BACKEND=marlin

# 64k から。65536 -> 131072 -> 262144 -> 393216 -> 524288 -> 786432 -> 1048576
# context 指定自体は VRAM を予約しない (KV pool は下の mem-fraction で決まる)
SG_CONTEXT_LENGTH=65536

# 重み + KV pool に使う VRAM 比率。Marlin 後の重みが約88%を占めるので
# 0.89 未満だと 64k 分の pool が取れず、0.93 超だと活性値の余地が無い
SG_MEM_FRACTION_STATIC=0.92

# sglang は DeepSeek V4 で既定 256 にするので必ず明示する
SG_MAX_RUNNING_REQUESTS=1

# prefill で OOM したらまずここを下げる (4096 -> 2048)
SG_CHUNKED_PREFILL_SIZE=4096
SG_CUDA_GRAPH_MAX_BS=2

# ローダは (N+2) x 3.6GB を rank ごとに常駐させる。上流既定の 8 は
# TP=2 で RAM 上限 256GB に対して危ない
SG_WEIGHT_LOAD_THREADS=4

SG_REASONING_PARSER=deepseek-v4
SG_TOOL_CALL_PARSER=deepseekv4

SG_PACKAGE=sglang==0.5.18

TUNNEL_TOKEN=

# Optional:
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
