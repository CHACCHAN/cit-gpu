# Qwen3.8-27B + SGLang / 新習志野 (gpumng, RTX A4500 20GB x4)

SG_MODEL_REPO=cyankiwi/Qwen3.8-27B-AWQ-INT4
SG_MODEL=models/Qwen3.8-27B-AWQ-INT4
SG_SERVED_MODEL_NAME=qwen3.8-27b

SG_HOST=0.0.0.0
# FreeToken/.env も 5050。コンテナは host network 共有なので同時起動不可
SG_PORT=5050

# TP=5 は不可。heads 24 / kv_heads 4 / GDN 16:48 / FFN 17408 が 5 で割り切れない
SG_TP_SIZE=4

# native 値。YaRN は使わない
SG_CONTEXT_LENGTH=262144

# 重み約5.0GiB/rank。0.85 で pool 約12GiB、非static 3.0GiB が残る
SG_MEM_FRACTION_STATIC=0.85

# 実測 (50並列/512tok/HiCache ON): 4 -> 223 tok/s p50 37.9s / 16 -> 479 tok/s p50 21.5s
# 16 でも GDN state 79slot中32、KV usage 0.00 で余裕あり
SG_MAX_RUNNING_REQUESTS=4
SG_MAX_QUEUED_REQUESTS=192

# 公式 cookbook 推奨。hybrid GDN では prefill chunk 中 decode が止まる
SG_CHUNKED_PREFILL_SIZE=2048
SG_CUDA_GRAPH_MAX_BS=4

# state slot: fp32 153.9MB -> bf16 78.4MB
SG_MAMBA_SSM_DTYPE=bfloat16
# 1req あたりの slot 数 S: extra_buffer 5 / extra_buffer_lazy 4 / no_buffer 3
SG_MAMBA_RADIX_CACHE_STRATEGY=extra_buffer_lazy
# GDN state pool / KV pool 比。ratio = S * 1197 / 平均req長。L=32768 想定
SG_MAMBA_FULL_MEMORY_RATIO=0.15

# 空(=flashinfer)でも動くが、SGLang 自身が Qwen3_5 系の既定に triton を選んでいる
SG_ATTENTION_BACKEND=triton
SG_SAMPLING_BACKEND=

SG_WEIGHT_LOAD_THREADS=4

# cookbook 指定。chat_template が <function=>/<parameter=> 形式なので hermes は不可
SG_REASONING_PARSER=qwen3
SG_TOOL_CALL_PARSER=qwen3_coder

SG_ENABLE_HICACHE=1
# rank ごとの GB。TP4 なので実際のホスト RAM は約4倍 (実測 165.8GB)
SG_HICACHE_SIZE=40
SG_HICACHE_WRITE_POLICY=write_through

SG_PACKAGE=sglang==0.5.18

SG_API_KEY=

# 新習志野 Qwen 専用の Tunnel を使うこと。津田沼 DeepSeek / FreeToken と共用しない。
# 空なら cloudflared は起動しない
TUNNEL_TOKEN=

# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 分散初期化ハング時の再試行 (クラスタ起因)。dist-timeout を切っておかないと
# torch 既定の 1800s まで無言で止まる
SG_DIST_TIMEOUT=600
# READY までは triton の JIT キャッシュ次第で大きく振れる。
# コールド (venv 作り直し後) 835s / ウォーム 185s (実測 job 14288 / 14299)。
# 差はほぼ prefill CUDA graph capture (441s vs 26s)。
# 900 だとコールド時に余裕が 65s しかなく、ウォッチドッグが誤発火する。
SG_STARTUP_TIMEOUT=1800
SG_STARTUP_RETRIES=5

# GPU 間 P2P が壊れた個体を掴むと NCCL の all_reduce が永久に返らない
# (src/p2p_check.py で確認できる)。1 で NCCL を共有メモリ経由に落とし、
# sglang の custom all-reduce も無効化する。TP の帯域は落ちるが確実に起動する。
# サイト側で P2P が直ったら 0 にする。
SG_NCCL_P2P_DISABLE=1
