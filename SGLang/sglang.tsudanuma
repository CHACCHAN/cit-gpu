#!/bin/bash

#SBATCH --partition=research
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus-per-task=2
#SBATCH --mem=256G
#SBATCH --time=24:00:00
#SBATCH --container=pytorch/pytorch:2.11.0-cuda13.0-cudnn9-devel
#SBATCH --output=logs/%j.log
#SBATCH --error=logs/%j.err

# TP=2 の rank 間転送に /dev/shm が必要。サイト既定の 16G では足りない
#CONTAINER --shm-size=32G

# 津田沼 (gpumng2, H100 NVL x2) / DeepSeek-V4-Flash / TP=2
# 共通パイプラインは src/launch.py。ここにはサイト固有の差分だけを書く。
# コンテナには /usr/local/cuda (toolkit 一式) があるので
# CUDA toolchain 補正 (SG_CUDA_FIXUPS) は不要 = 既定 0 のまま。

set -euo pipefail
# コンテナ起動はスクリプトを /tmp/slurm/startup へコピーして実行し、
# SLURM_SUBMIT_DIR などの環境変数も渡さないので dirname "$0" は使えない。
# cwd は submit dir (home は /root にマウント) のまま始まるので $PWD に落とす。
cd "${SLURM_SUBMIT_DIR:-$PWD}"

set -a
source "${ENV_FILE:-.env}"
set +a

# このサイトは外部公開が前提なので token を必須にする
: "${TUNNEL_TOKEN:?}"

# serve へのサイト固有引数。共通分は src/serve.py の base_args()。
# 以下は渡さない。sglang が DeepseekV4ForCausalLM から自動で決めるため、
# 上書きすると壊れる:
#   --attention-backend -> dsv4 / --page-size -> 256
#   --kv-cache-dtype -> fp8_e4m3 / --quantization -> config.json 由来
ARGS=(
    --moe-runner-backend "${SG_MOE_RUNNER_BACKEND:?}"
    --enable-hierarchical-cache
    --hicache-ratio 2
)

# encoding/encoding_dsv4.py は sglang が reasoning-effort の判定に読むので必須
exec python3 -u src/launch.py --marker encoding/encoding_dsv4.py -- "${ARGS[@]}"
