# Copy to .env (chmod 600). Existing llama/.env credentials can be reused.
FT_API_KEY=
TUNNEL_TOKEN=

# The 126 GiB checkpoint must be staged outside the 80 GiB home quota.
FT_MODEL_PATH=/tmp/cit-gpu-qwen3.8-flash-next
FT_STAGE_MODEL=1
FT_MODEL_ID=Qwen3.8-Flash-Next-ABLITERATED-NVFP4
# 1-5。初回の資源確認には 1 を指定できる。
FT_REPLICAS=5
FT_PORT=5050
FT_WORKER_PORT=5051
FT_STARTUP_TIMEOUT=3600
FT_VERIFY_ROUTING=1
FT_AUTO_RENEW=1
FT_MAX_RUNNING_REQUESTS=1
FT_MEMORY_RATIO=0.95
FT_MOE_CACHE_SIZE=512
FT_MOE_STRATEGY=offload
# A4500 20GB で256kを優先する場合は画像エンコーダーを外す
FT_TEXT_MODEL_ONLY=1
FT_MAX_PREFILL_LENGTH=1024
FT_DISABLE_MOE_PREFILL_OVERLAP=1
