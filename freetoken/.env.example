# Copy to .env (chmod 600). Existing llama/.env credentials can be reused.
FT_API_KEY=
TUNNEL_TOKEN=

# The 126 GiB checkpoint must be staged outside the 80 GiB home quota.
FT_MODEL_PATH=/tmp/cit-gpu-qwen3.8-flash-next
FT_STAGE_MODEL=1
FT_MODEL_ID=Qwen3.8-Flash-Next-ABLITERATED-NVFP4
# 1-8。初回の資源確認には 1 を指定できる。新習志野は5、津田沼は2 (GPU 2 枚の上限)。
FT_REPLICAS=5
# 自動更新で再投入するジョブファイル名 (新習志野: shinnarashino、津田沼: tsudanuma)
FT_JOB_SCRIPT=shinnarashino
# worker ごとの KV 上限。FT_NUM_TOKENS は worker 全体の KV プールで、
# 未指定なら FT_MAX_SEQ_LEN と同じ。N 並列で全枠 262144 を確保するなら N * 262144。
# FT_MAX_SEQ_LEN=262144
# FT_NUM_TOKENS=262144
# FT_EXTRA_ARGS='ft serve' に追加する引数 (空白区切り)
# FT_GATEWAY_CONCURRENCY=64
# round_robin (既定) か cache_aware。長い会話を同じ worker に送って prefix cache を効かせるなら cache_aware。
# FT_ROUTING_POLICY=round_robin
# 内部 Gateway のポート。公開の FT_PORT は auth_proxy.py が受ける。
# FT_GATEWAY_PORT=5049
# FT_PROMETHEUS_PORT=29000
# FT_MOE_CACHE_AUTO=1 は VRAM の空きに合わせて MoE cache を増やす (H100 94GB 向け。A4500 では OOM)。
FT_PORT=5050
FT_WORKER_PORT=5051
FT_STARTUP_TIMEOUT=3600
FT_VERIFY_ROUTING=1
FT_AUTO_RENEW=1
FT_MAX_RUNNING_REQUESTS=1
FT_MEMORY_RATIO=0.95
FT_MOE_CACHE_SIZE=512
FT_MOE_STRATEGY=offload
# A4500 20GB で256kを優先する場合は画像エンコーダーを外す
FT_TEXT_MODEL_ONLY=1
FT_MAX_PREFILL_LENGTH=1024
FT_DISABLE_MOE_PREFILL_OVERLAP=1
