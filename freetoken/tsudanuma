#!/bin/bash
#SBATCH --job-name=freetoken
#SBATCH --partition=research
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus-per-task=2
#SBATCH --mem=256G
#SBATCH --time=24:00:00
#SBATCH --output=logs/%j.log
#SBATCH --error=logs/%j.err
set -euo pipefail
# Slurm はスクリプトをコピーするので自分の場所は使えない。freetoken/ でもリポジトリ直下でも投入できる
cd "${SLURM_SUBMIT_DIR:-$PWD}"
[ -f launch.py ] || cd freetoken
mkdir -p logs
exec python3 -u launch.py
