#!/bin/bash
#SBATCH --job-name=bonsai
#SBATCH --partition=research
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --gpus-per-task=5
#SBATCH --mem=240G
#SBATCH --time=24:00:00
#SBATCH --output=logs/%j.log
#SBATCH --error=logs/%j.err

# 新習志野 A4500 x5 / Ternary Bonsai 2 27B PQ2_0, 1 GPU に 163840 x 2 slot を5つ
set -euo pipefail
# llama/ でも llama/<site>/ でも投入できる (Slurm はスクリプトをコピーするので自分の場所は使えない)
# ログは投入したディレクトリの logs/ に出る
cd "${SLURM_SUBMIT_DIR:-$PWD}"
[ -f common/launch.py ] || cd ..
exec python3 -u common/launch.py "$@" \
    --server llama.cpp-prism/build/bin/llama-server \
    --model models/Bonsai-2-27B/Ternary-Bonsai-2-27B-PQ2_0.gguf \
    --alias bonsai-2-27b-pq2_0 --replicas 5 \
    -- \
    -ngl 999 -fa on -ctk q8_0 -ctv q8_0 \
    --threads 2 --threads-batch 2 --threads-http 16 -c 327680 --parallel 2 \
    --cache-ram 32768 --metrics \
    --fit off --jinja --chat-template-file shinnarashino/bonsai.jinja
