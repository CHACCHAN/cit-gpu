#!/bin/bash

#SBATCH --partition=research
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=1
#SBATCH --mem=192G
#SBATCH --time=24:00:00
#SBATCH --container=pytorch/pytorch:2.11.0-cuda13.0-cudnn9-devel
#SBATCH --output=logs/%j.log
#SBATCH --error=logs/%j.err

set -euo pipefail

WORKDIR="${SLURM_SUBMIT_DIR:-$PWD}"
ENV_FILE="${ENV_FILE:-$WORKDIR/.env}"

set -a
source "$ENV_FILE"
set +a

: "${FT_MODEL_REPO:?FT_MODEL_REPO is required}"
: "${FT_MODEL:?FT_MODEL is required}"
: "${FT_HOST:?FT_HOST is required}"
: "${FT_PORT:?FT_PORT is required}"
: "${FT_TP_SIZE:?FT_TP_SIZE is required}"
: "${FT_MAX_RUNNING_REQUESTS:?FT_MAX_RUNNING_REQUESTS is required}"
: "${FT_MAX_SEQ_LEN:?FT_MAX_SEQ_LEN is required}"
: "${FT_NUM_TOKENS:?FT_NUM_TOKENS is required}"
: "${FT_MOE_CACHE_SIZE:?FT_MOE_CACHE_SIZE is required}"
: "${FT_MEMORY_RATIO:?FT_MEMORY_RATIO is required}"
: "${FT_MOE_BACKEND:?FT_MOE_BACKEND is required}"
: "${TUNNEL_TOKEN:?TUNNEL_TOKEN is required}"

resolve_path() {
    if [[ "$1" = /* ]]; then
        printf '%s\n' "$1"
    else
        printf '%s/%s\n' "$WORKDIR" "$1"
    fi
}

MODEL_PATH="$(resolve_path "$FT_MODEL")"
FT_VENV="$(resolve_path ".venv")"
HF_HOME="$(resolve_path ".hf-cache")"
CLOUDFLARED="$(resolve_path "bin/cloudflared")"

export HF_HOME
export HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PIP_NO_CACHE_DIR=1

mkdir -p "$HF_HOME"

# CloudFlare Tunnel
if [[ ! -x "$CLOUDFLARED" ]]; then
    mkdir -p "$(dirname "$CLOUDFLARED")"

python - "$CLOUDFLARED" <<'PY'
import sys
import urllib.request
url = "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64"
dest = sys.argv[1]
print(f"Downloading cloudflared -> {dest}")
req = urllib.request.Request(
    url,
    headers={"User-Agent": "FreeToken-Slurm"}
)

with urllib.request.urlopen(req) as response, open(dest, "wb") as f:
    while chunk := response.read(1024 * 1024):
        f.write(chunk)
PY

    chmod +x "$CLOUDFLARED"
fi

"$CLOUDFLARED" tunnel \
    --no-autoupdate \
    --loglevel info \
    run &

CLOUDFLARED_PID=$!

echo "cloudflared started: PID=$CLOUDFLARED_PID"

# FreeToken の仮想環境
if [[ ! -x "$FT_VENV/bin/ft" ]]; then
    python -m pip install \
        --break-system-packages \
        --no-cache-dir \
        virtualenv

    python -m virtualenv \
        --system-site-packages \
        "$FT_VENV"

    "$FT_VENV/bin/python" -m pip install \
        --no-cache-dir \
        "${FT_PACKAGE:-freetoken[accel]==0.1.2}"
fi

# モデルが存在しなければ Hugging Face から取得
if [[ ! -f "$MODEL_PATH/config.json" || ! -f "$MODEL_PATH/inference/config.json" ]]; then
    echo "Downloading model: $FT_MODEL_REPO"
    echo "Destination: $MODEL_PATH"

    mkdir -p "$MODEL_PATH"

    "$FT_VENV/bin/python" - "$FT_MODEL_REPO" "$MODEL_PATH" <<'PY'
import sys
from huggingface_hub import snapshot_download

repo_id = sys.argv[1]
local_dir = sys.argv[2]

snapshot_download(
    repo_id=repo_id,
    local_dir=local_dir,
)
PY
fi

# DeepSeek V4 が必要とするファイルを念のため確認
if [[ ! -f "$MODEL_PATH/config.json" ]]; then
    echo "ERROR: $MODEL_PATH/config.json not found"
    exit 1
fi

if [[ ! -f "$MODEL_PATH/inference/config.json" ]]; then
    echo "ERROR: $MODEL_PATH/inference/config.json not found"
    exit 1
fi

# --------------------------------------------------
# NCCL workaround for FreeToken TP > 1
# --------------------------------------------------

if (( FT_TP_SIZE > 1 )); then
    NCCL_SO="$(find \
        "$FT_VENV/lib" \
        /usr/local/lib \
        /usr/lib \
        -name 'libnccl.so.2' \
        -type f \
        -print -quit 2>/dev/null || true)"

    if [[ -z "$NCCL_SO" ]]; then
        echo "ERROR: libnccl.so.2 not found"
        exit 1
    fi

    echo "Found NCCL: $NCCL_SO"

    ln -sf "$NCCL_SO" /usr/local/cuda/lib64/libnccl.so

    export LD_LIBRARY_PATH="$(dirname "$NCCL_SO"):/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

cleanup() {
    if [[ -n "${CLOUDFLARED_PID:-}" ]]; then
        kill "$CLOUDFLARED_PID" 2>/dev/null || true
    fi
}

trap cleanup EXIT INT TERM

"$FT_VENV/bin/ft" serve \
    --model "$MODEL_PATH" \
    --served-model-name "$FT_SERVED_MODEL_NAME" \
    --host "$FT_HOST" \
    --port "$FT_PORT" \
    --tp-size "$FT_TP_SIZE" \
    --max-running-requests "$FT_MAX_RUNNING_REQUESTS" \
    --max-seq-len-override "$FT_MAX_SEQ_LEN" \
    --num-tokens "$FT_NUM_TOKENS" \
    --memory-ratio "$FT_MEMORY_RATIO" \
    --moe-backend "$FT_MOE_BACKEND" \
    --moe-cache-size "$FT_MOE_CACHE_SIZE"
